<?xml version="1.0" encoding="UTF-8"?>
<biz x:schema="/nop/schema/biz/xbiz.xdef"
     xmlns:x="/nop/schema/xdsl.xdef"
     x:extends="_ErpProduct.xbiz"
     xmlns:bo="bo"
     xmlns:c="c">

    <actions>
        <query name="active_findPage" x:prototype="findPage">
            <source>
                <bo:DoFindPage query="${query}" selection="${selection}" xpl:lib="/nop/biz/xlib/bo.xlib">
                    <filter>
                        <eq name="status" value="ACTIVE"/>
                    </filter>
                </bo:DoFindPage>
            </source>
        </query>
    </actions>
</biz>
